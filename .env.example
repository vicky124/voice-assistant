# Each provider is optional. Without keys, the app runs in offline echo mode with browser speech.
ANTHROPIC_API_KEY=
VOICE_MODEL=claude-opus-5-5
VOICE_EFFORT=low
DEEPGRAM_API_KEY=
# Set to "polly" (needs AWS credentials) for server-side neural voices.
TTS_PROVIDER=
POLLY_VOICE=Joanna
AWS_REGION=us-east-1
